{
  "name": "dsh-agent-attribution",
  "version": "0.1.0",
  "description": "Tells DSH agents how to attribute git commits and pull requests, like Claude Code's attribution setting",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "index.js",
    "attribution.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
